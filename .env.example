# Salin file ini menjadi .env lalu isi nilainya.

# --- Database ---
# Neon: pakai koneksi langsung (host TANPA "-pooler") untuk lokal & migrasi.
# Di Vercel boleh pakai host "-pooler".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Alternatif lokal dengan Docker (npm run db:up):
# DATABASE_URL=postgres://tracker:tracker@localhost:5433/learning_tracker

# --- Login (Auth.js + GitHub) ---
# Buat dengan: npx auth secret   (atau string acak minimal 32 karakter)
AUTH_SECRET=
# Dari GitHub > Settings > Developer settings > OAuth Apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Opsional: batasi login hanya untuk username GitHub tertentu (pisahkan dengan koma).
# Kosong / tidak di-set = siapa pun dengan akun GitHub bisa mendaftar (data tiap user terpisah).
AUTH_ALLOWED_GITHUB=

# --- Upload gambar di catatan (Vercel Blob) ---
# Vercel > project > Storage > Create > Blob (akses: Public) → token otomatis masuk ke env Vercel.
# Untuk lokal, salin nilainya ke sini. Kalau kosong saat `npm run dev`, gambar disimpan di public/uploads/dev.
BLOB_READ_WRITE_TOKEN=
